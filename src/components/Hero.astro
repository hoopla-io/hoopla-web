---
import { useTranslations, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const tickerWords = [
  t("hero.text-1").replace(/\.$/, ""),
  t("hero.text-2").replace(/\.$/, ""),
  t("hero.text-3").replace(/\.$/, ""),
  "Hoopla",
  t("cashback.word"),
];
---

<section class="relative overflow-hidden pt-32 pb-0 sm:pt-36">
  <!-- Coffee ring decorations -->
  <div class="coffee-ring h-64 w-64 -top-16 right-[8%] hidden md:block"></div>
  <div class="coffee-ring h-40 w-40 bottom-40 left-[-3rem]"></div>

  <div class="container mx-auto px-5">
    <div class="grid items-center gap-10 lg:grid-cols-[1.25fr_1fr]">
      <div class="relative z-10">
        <p class="eyebrow rise rise-1 text-brand">
          Toshkent · Coffee · {t("cashback.word")}
        </p>
        <h1 class="display mt-6 text-[clamp(3.2rem,9.5vw,7.5rem)] font-bold">
          <span class="rise rise-1 block text-ink">{t("hero.text-1")}</span>
          <span class="rise rise-2 outline-brand block">{t("hero.text-2")}</span>
          <span class="rise rise-3 block text-brand">{t("hero.text-3")}</span>
        </h1>
        <p class="rise rise-4 mt-7 max-w-lg text-lg leading-relaxed text-ink-soft">
          {t("hero.subtitle")}
        </p>

        <div class="rise rise-5 mt-9 flex flex-col gap-4 sm:flex-row">
          <a
            href="https://apps.apple.com/app/hoopla/id6739946223"
            target="_blank"
            rel="noopener noreferrer"
            class="sticker -rotate-1"
          >
            <svg class="h-8 w-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
            </svg>
            <span class="flex flex-col text-left leading-tight">
              <span class="text-[0.65rem] uppercase tracking-wider opacity-80">{t("hero.download")}</span>
              <span class="text-lg font-semibold">App Store</span>
            </span>
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=uz.alphazet.hoopla"
            target="_blank"
            rel="noopener noreferrer"
            class="sticker rotate-1"
          >
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.5,12.92 20.16,13.19L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z" />
            </svg>
            <span class="flex flex-col text-left leading-tight">
              <span class="text-[0.65rem] uppercase tracking-wider opacity-80">{t("hero.download")}</span>
              <span class="text-lg font-semibold">Google Play</span>
            </span>
          </a>
        </div>
      </div>

      <div class="relative hidden justify-center lg:flex">
        <div class="coffee-ring h-80 w-80 top-6 left-1/2 -translate-x-1/2"></div>
        <img
          src="/images/cup-3d.webp"
          alt=""
          width="420"
          height="420"
          class="bob relative z-10 w-[26rem] drop-shadow-[0_30px_40px_rgba(34,21,16,0.25)]"
          loading="eager"
        />
        <!-- Rotating badge -->
        <div class="absolute right-4 top-2 z-20 h-28 w-28">
          <svg viewBox="0 0 100 100" class="spin-slow h-full w-full">
            <defs>
              <path id="circlePath" d="M 50,50 m -37,0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" />
            </defs>
            <circle cx="50" cy="50" r="50" fill="var(--color-honey)" />
            <text fill="var(--color-ink)" font-size="11" font-weight="700" letter-spacing="2.5">
              <textPath href="#circlePath">
                HOOPLA · {t("cashback.word").toUpperCase()} · HOOPLA ·
              </textPath>
            </text>
          </svg>
          <span class="display absolute inset-0 flex items-center justify-center text-3xl font-bold text-ink">%</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Ticker strip -->
  <div class="ticker marquee mt-16 -rotate-1 scale-x-105" aria-hidden="true">
    <div class="marquee-track" style="--marquee-duration: 26s;">
      {
        [0, 1].map(() => (
          <span class="ticker-item">
            {Array.from({ length: 4 }).map(() => (
              <>
                {tickerWords.map((w) => (
                  <>
                    {w}<span class="sep">✦</span>
                  </>
                ))}
              </>
            ))}
          </span>
        ))
      }
    </div>
  </div>
</section>
