---
import { useTranslations, localePath, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();

const socials = [
  {
    name: "Instagram",
    href: "https://www.instagram.com/hoopla.uz/",
    icon: "M12 2.2c3.2 0 3.6 0 4.9.07 3.3.15 4.7 1.6 4.9 4.9.06 1.3.07 1.6.07 4.8s-.01 3.6-.07 4.8c-.15 3.3-1.6 4.7-4.9 4.9-1.3.06-1.6.07-4.9.07s-3.6-.01-4.9-.07c-3.3-.15-4.7-1.6-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s.01-3.6.07-4.8c.15-3.3 1.6-4.7 4.9-4.9C8.4 2.2 8.8 2.2 12 2.2zm0 3.6a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0 0-12.4zm0 2.2a4 4 0 1 1 0 8 4 4 0 0 1 0-8zm6.4-2.7a1.44 1.44 0 1 0 0 2.9 1.44 1.44 0 0 0 0-2.9z",
  },
  {
    name: "Facebook",
    href: "https://www.facebook.com/hoopla.uz/",
    icon: "M14 13.5h2.5l1-4H14v-2c0-1 .5-2 2-2h1.5V2.14S16.14 2 14.86 2C12.14 2 10.5 3.66 10.5 6.7v2.8H8v4h2.5V22h3.5v-8.5z",
  },
  {
    name: "Telegram",
    href: "https://t.me/hoopla_support",
    icon: "M21.9 4.6 19 19.3c-.2 1-.8 1.3-1.6.8l-4.5-3.3-2.2 2.1c-.24.24-.44.44-.9.44l.32-4.6L18.6 7c.36-.32-.08-.5-.56-.18L7.7 13.3 3.26 12c-.96-.3-.98-.96.2-1.42l17.2-6.6c.8-.3 1.5.18 1.24 1.4z",
  },
];
---

<footer class="relative overflow-hidden bg-brand text-paper">
  <div class="container mx-auto px-5 pt-16 pb-10">
    <div class="grid gap-12 md:grid-cols-3">
      <div>
        <p class="display text-4xl font-bold lowercase">
          hoopla<span class="text-honey">.</span>
        </p>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-paper/80">
          {t("hero.subtitle")}
        </p>
        <div class="mt-6 flex gap-4">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.name}
                class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-paper/40 text-paper transition-colors hover:border-honey hover:text-honey"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d={s.icon} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <h3 class="eyebrow text-honey">{t("footer.quick-links.title")}</h3>
        <ul class="mt-5 space-y-3 text-sm">
          <li>
            <a href={localePath(locale, "/privacy-policy")} class="hover:underline">
              {t("footer.quick-links.privacy-policy")}
            </a>
          </li>
          <li>
            <a href={localePath(locale, "/terms-of-use")} class="hover:underline">
              {t("footer.quick-links.terms-of-service")}
            </a>
          </li>
          <li>
            <a href={localePath(locale, "/contact")} class="hover:underline">
              {t("footer.quick-links.help-center")}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="eyebrow text-honey">{t("contacts.reach-us")}</h3>
        <address class="mt-5 space-y-3 text-sm not-italic text-paper/80">
          <p>{t("contacts.location")}</p>
          <p>
            <a href="tel:+998500772274" class="font-semibold text-paper hover:text-honey">
              +998 50 077 22 74
            </a>
          </p>
          <p>
            <a
              href="https://t.me/hoopla_support"
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-paper hover:text-honey"
            >
              t.me/hoopla_support
            </a>
          </p>
        </address>
      </div>
    </div>

    <div class="mt-14 border-t border-paper/20 pt-6 text-center text-xs text-paper/60">
      &copy; {year} Hoopla · {t("footer-rights")}
    </div>
  </div>

  <!-- Giant watermark -->
  <p
    aria-hidden="true"
    class="display pointer-events-none absolute -bottom-10 left-1/2 -translate-x-1/2 text-[22vw] font-bold lowercase leading-none text-paper/5 select-none"
  >
    hoopla
  </p>
</footer>
