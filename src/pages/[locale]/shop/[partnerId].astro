---
import Base from "@/layouts/Base.astro";
import DeepLinkSheet from "@/components/DeepLinkSheet.astro";
import {
  getPartnerBanners,
  getPartnerDetail,
  getShopDrinks,
  formatBalance,
  type ShopDrink,
} from "@/lib/api";
import { isLocale, useTranslations, localePath, type Locale } from "@/i18n";

export const prerender = false;

const localeParam = Astro.params.locale;
if (!isLocale(localeParam)) {
  return new Response(null, { status: 404 });
}
const locale: Locale = localeParam;
const partnerId = Astro.params.partnerId ?? "";
const t = useTranslations(locale);

const partnerData = await getPartnerDetail(partnerId);
if (!partnerData) {
  return new Response(null, { status: 404 });
}

const [categoriesRaw, banners] = await Promise.all([
  getShopDrinks(partnerId),
  getPartnerBanners(partnerData.partnerId ?? 0),
]);

const hasRealCategories = categoriesRaw.some(
  (c) => c.name && c.name.toLowerCase() !== "other"
);
const allDrinks: ShopDrink[] = categoriesRaw.flatMap((c) => c.drinks);

const pictures = partnerData.pictures ?? [];
const phoneNumbers = partnerData.phoneNumbers ?? [];
const workingHours = partnerData.workingHours ?? [];
const urls = partnerData.urls ?? [];
const heroImage = pictures[0]?.pictureUrl || partnerData.pictureUrl || "";

const today = new Date()
  .toLocaleString("en-US", { weekday: "long", timeZone: "Asia/Tashkent" })
  .toLowerCase();
const todayHours = workingHours.find((h) => h.weekDay === today);
const todaysLabel = todayHours
  ? `${todayHours.openAt} – ${todayHours.closeAt}`
  : t("partner.closed-today");

const yandexUrl = partnerData.location
  ? `https://yandex.uz/maps/?ll=${partnerData.location.lng},${partnerData.location.lat}&z=16&mode=whatshere&whatshere[point]=${partnerData.location.lng},${partnerData.location.lat}`
  : null;

const shopPath = `/${locale}/shop/${partnerId}`;
---

<Base
  locale={locale}
  title={`${partnerData.name} — Hoopla`}
  description={`${partnerData.name} · Hoopla`}
  path={`/shop/${partnerId}`}
  noChrome
>
  <main class="min-h-screen bg-paper pb-24">
    <div class="mx-auto max-w-lg">
      <!-- Hero -->
      <div class="relative">
        {
          heroImage ? (
            <img
              src={heroImage}
              alt={partnerData.name}
              class="aspect-[3/2] w-full object-cover"
              loading="eager"
            />
          ) : (
            <div class="flex aspect-[3/2] w-full items-center justify-center bg-paper-deep">
              <span class="display text-4xl font-bold text-brand lowercase">hoopla</span>
            </div>
          )
        }
        <button
          onclick={`history.length > 1 ? history.back() : (window.location.href = '${localePath(locale, "/")}')`}
          aria-label={t("partner.back")}
          class="absolute left-4 top-4 flex h-10 w-10 items-center justify-center rounded-full border-2 border-ink bg-foam shadow-[3px_3px_0_rgba(34,21,16,0.85)] transition-transform active:translate-x-0.5 active:translate-y-0.5"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5m6-7-7 7 7 7"></path>
          </svg>
        </button>
      </div>

      <div class="space-y-6 px-4 pt-5">
        <h1 class="display text-3xl font-bold text-ink">{partnerData.name}</h1>

        <!-- Info card -->
        <div class="press-card space-y-4 p-5">
          {
            workingHours.length > 0 && (
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                  </svg>
                </span>
                <div>
                  <p class="text-xs text-ink-soft/70">{t("partner.todays-hours")}</p>
                  <p class="text-sm font-semibold text-ink">{todaysLabel}</p>
                </div>
              </div>
            )
          }

          {
            yandexUrl && (
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                </span>
                <a
                  href={yandexUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-semibold text-brand underline-offset-2 hover:underline"
                >
                  {t("partner.open-in-yandex")}
                </a>
              </div>
            )
          }

          {
            phoneNumbers.map((phone) => (
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z" />
                  </svg>
                </span>
                <a href={`tel:+${phone.phoneNumber}`} class="text-sm font-semibold text-ink">
                  +{phone.phoneNumber}
                </a>
              </div>
            ))
          }

          {
            urls.length > 0 && (
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" />
                  </svg>
                </span>
                <div class="flex flex-wrap gap-x-4 gap-y-1">
                  {urls.map((url) => (
                    <a
                      href={url.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-sm font-semibold text-brand underline-offset-2 hover:underline"
                    >
                      {url.urlType === "instagram" ? t("partner.instagram") : t("partner.website")}
                    </a>
                  ))}
                </div>
              </div>
            )
          }
        </div>

        <!-- Photos -->
        {
          pictures.length > 1 && (
            <section>
              <h2 class="display mb-3 text-xl font-bold text-ink">{t("partner.photos")}</h2>
              <div class="flex gap-3 overflow-x-auto pb-2">
                {pictures.map((pic, i) => (
                  <img
                    src={pic.pictureUrl}
                    alt={`${partnerData.name} ${i + 1}`}
                    class="h-24 w-32 shrink-0 rounded-xl border-2 border-ink object-cover"
                    loading="lazy"
                  />
                ))}
              </div>
            </section>
          )
        }

        <!-- Banners -->
        {
          banners.length > 0 && (
            <section class="flex snap-x snap-mandatory gap-3 overflow-x-auto pb-2">
              {banners.map((banner) => {
                const isUrl = banner.linkType === "url";
                const href = isUrl
                  ? banner.linkValue
                  : banner.linkType === "partner"
                    ? `/${locale}/shop/${banner.linkValue}`
                    : "#menu";
                return (
                  <a
                    href={href}
                    target={isUrl ? "_blank" : undefined}
                    rel={isUrl ? "noopener noreferrer" : undefined}
                    class="w-[85%] shrink-0 snap-center overflow-hidden rounded-2xl border-2 border-ink"
                  >
                    <img
                      src={banner.imageUrl}
                      alt={banner.title ?? "banner"}
                      class="aspect-video w-full object-cover"
                      loading="lazy"
                    />
                  </a>
                );
              })}
            </section>
          )
        }

        <!-- Menu -->
        {
          allDrinks.length > 0 && (
            <section id="menu">
              <h2 class="display mb-3 text-xl font-bold text-ink">{t("partner.menu")}</h2>

              {hasRealCategories && (
                <div
                  id="category-tabs"
                  class="sticky top-0 z-10 -mx-4 mb-4 flex gap-2 overflow-x-auto bg-paper px-4 py-3 shadow-[0_6px_8px_-6px_rgba(34,21,16,0.2)]"
                >
                  {categoriesRaw.map((cat, i) => (
                    <button
                      data-target={`cat-${cat.id}`}
                      class:list={[
                        "tab-btn shrink-0 rounded-full border-2 border-ink px-4 py-1.5 text-sm font-semibold transition-colors",
                        i === 0 ? "bg-brand text-foam" : "bg-foam text-ink",
                      ]}
                    >
                      {cat.name}
                    </button>
                  ))}
                </div>
              )}

              {hasRealCategories ? (
                <div class="space-y-8">
                  {categoriesRaw.map((cat) => (
                    <div id={`cat-${cat.id}`} class="scroll-mt-20">
                      <h3 class="mb-3 text-lg font-bold text-ink">{cat.name}</h3>
                      <div class="grid grid-cols-2 gap-3">
                        {cat.drinks.map((drink) => (
                          <article class="overflow-hidden rounded-2xl border-2 border-ink bg-foam">
                            {drink.pictureUrl ? (
                              <img src={drink.pictureUrl} alt={drink.name} class="aspect-square w-full object-cover" loading="lazy" />
                            ) : (
                              <div class="flex aspect-square w-full items-center justify-center bg-paper-deep text-brand">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                                  <path d="M17 8h1a4 4 0 1 1 0 8h-1M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V8z" />
                                </svg>
                              </div>
                            )}
                            <div class="p-3">
                              <h4 class="truncate text-sm font-semibold text-ink">{drink.name}</h4>
                              <p class="mt-1 text-sm font-bold text-brand">
                                {formatBalance(drink.productPrice)} {t("partner.uzs")}
                              </p>
                            </div>
                          </article>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="grid grid-cols-2 gap-3">
                  {allDrinks.map((drink) => (
                    <article class="overflow-hidden rounded-2xl border-2 border-ink bg-foam">
                      {drink.pictureUrl ? (
                        <img src={drink.pictureUrl} alt={drink.name} class="aspect-square w-full object-cover" loading="lazy" />
                      ) : (
                        <div class="flex aspect-square w-full items-center justify-center bg-paper-deep text-brand">
                          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                            <path d="M17 8h1a4 4 0 1 1 0 8h-1M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V8z" />
                          </svg>
                        </div>
                      )}
                      <div class="p-3">
                        <h4 class="truncate text-sm font-semibold text-ink">{drink.name}</h4>
                        <p class="mt-1 text-sm font-bold text-brand">
                          {formatBalance(drink.productPrice)} {t("partner.uzs")}
                        </p>
                      </div>
                    </article>
                  ))}
                </div>
              )}
            </section>
          )
        }
      </div>
    </div>
  </main>

  <DeepLinkSheet locale={locale} path={shopPath} />
</Base>

<script>
  // Category tabs: click scrolls to section and updates the active pill
  const tabs = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  const activate = (btn: HTMLButtonElement) => {
    tabs.forEach((b) => {
      const active = b === btn;
      b.classList.toggle("bg-brand", active);
      b.classList.toggle("text-foam", active);
      b.classList.toggle("bg-foam", !active);
      b.classList.toggle("text-ink", !active);
    });
  };
  tabs.forEach((btn) => {
    btn.addEventListener("click", () => {
      activate(btn);
      const target = document.getElementById(btn.dataset.target ?? "");
      target?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });
</script>
