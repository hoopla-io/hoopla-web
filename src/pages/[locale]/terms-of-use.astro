---
import Base from "@/layouts/Base.astro";
import { terms } from "@/data/terms";
import { getStaticLocalePaths, type Locale } from "@/i18n";

export function getStaticPaths() {
  return getStaticLocalePaths();
}

const locale = Astro.params.locale as Locale;
const doc = terms[locale];
---

<Base locale={locale} title={`Hoopla — ${doc.title}`} path="/terms-of-use">
  <main class="pt-32 pb-24">
    <div class="container mx-auto px-5">
      <h1 class="display max-w-3xl text-4xl font-bold text-brand sm:text-6xl">
        {doc.title}
      </h1>
      <div class="legal-prose mt-10" set:html={doc.content} />
    </div>
  </main>
</Base>
